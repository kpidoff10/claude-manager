CM_API_TOKEN=token-bearer-pour-le-mcp
CM_WEB_PASSWORD=mot-de-passe-de-l-interface-web
CM_SESSION_SECRET=cle-de-signature-des-cookies
CM_PUBLIC_URL=https://manager.exemple.com
# Domaine servi par Traefik (docker-compose.yml).
CM_DOMAIN=manager.exemple.com
# Hôte des liens d'aperçu ouverts par le worker (IP ou nom du serveur).
CM_PREVIEW_HOST=localhost
CM_PROJECTS_ROOT=/home/dev/projects
# Facultatif : sans lui, aucune notification ne part et rien ne casse.
# Jeton obtenu auprès de @BotFather sur Telegram.
CM_TELEGRAM_TOKEN=
# Chemin absolu de logs/runs de ce dépôt, visible du conteneur (sous CM_PROJECTS_ROOT).
CM_RUN_LOG_DIR=/home/dev/projects/claude-manager/logs/runs
